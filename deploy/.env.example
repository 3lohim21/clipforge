# ---- required -------------------------------------------------------------------------
# Public hostname; Caddy obtains a Let's Encrypt certificate for it automatically.
DOMAIN=clips.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# First boot creates the owner account from these (ignored once any user exists).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too-at-least-10-chars

# ---- processing ------------------------------------------------------------------------
# Whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo (GPU)
WHISPER_MODEL=small
# Reuse YouTube's own captions when available (instant, free). Set false to always run Whisper.
PREFER_PLATFORM_CAPTIONS=true
DOWNLOAD_MAX_HEIGHT=1080
MAX_SOURCE_DURATION_S=21600
WORKER_CONCURRENCY=2
# Exports: libx264 preset (ultrafast..medium) and quality (lower = better, 18-23 typical)
RENDER_PRESET=veryfast
RENDER_CRF=20

# ---- platform access (see docs/DEPLOYMENT.md "YouTube bot checks") ----------------------
# Netscape-format cookies file mounted into the container, e.g. /data/cookies.txt
# YTDLP_COOKIES_FILE=/data/cookies.txt
# YTDLP_PROXY=http://user:pass@residential-proxy:port

# ---- optional AI titles / re-ranking ----------------------------------------------------
# Leave empty to use only the free built-in moment detector.
ANTHROPIC_API_KEY=
# Default is the most capable model; claude-sonnet-5-5 / claude-haiku-5-5 cost less.
LLM_MODEL=claude-opus-5-5

# ---- observability -----------------------------------------------------------------------
LOG_LEVEL=INFO
# Protect /metrics (Prometheus sends: Authorization: Bearer <token>)
METRICS_TOKEN=
